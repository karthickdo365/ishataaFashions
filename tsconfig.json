
{
  "compilerOptions": {
    "target": "ES2022",
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "isolatedModules": true,
    "skipLibCheck": true,

    // Allow JavaScript files and check their types.
    "allowJs": true,
    "checkJs": true,

    "noEmit": true,

    "types": [
      "vite/client",
      "node"
    ],

    // Configure the @ alias for src.
    "paths": {
      "@/*": [
        "./src/*"
      ]
    },

    "allowImportingTsExtensions": true
  },

  "include": [
    "src",
    "server"
  ]
}
